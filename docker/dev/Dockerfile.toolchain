# syntax=docker/dockerfile:1.7

# Dev image — bundles the full toolchain so `docker compose up` gives
# a developer a ready-to-go shell with everything installed. The
# compose file bind-mounts the host source over /flezha, so source
# edits show up live inside the container.
FROM hexpm/elixir:1.20.2-erlang-28.5.0.5-debian-bookworm-20260713-slim

WORKDIR /flezha

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        unzip \
        git \
        pkg-config \
        build-essential \
        cmake \
        libssl-dev \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 + TypeScript for the testnet TS app and the websocket-plugin
# test cases that drive it.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g typescript \
    && rm -rf /var/lib/apt/lists/*

# UID/GID 1000 matches the host convention so bind-mounted files stay
# read/writable from both sides.
RUN addgroup --gid 1000 flezha \
    && adduser --uid 1000 --gid 1000 --home /home/flezha flezha
ENV HOME=/home/flezha \
    CARGO_HOME=/home/flezha/.cargo \
    RUSTUP_HOME=/home/flezha/.rustup \
    PATH="/home/flezha/.cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable --profile minimal \
    && chown -R flezha:flezha /home/flezha/.cargo /home/flezha/.rustup

# socket_data is outside the bind-mount so its named-volume ownership
# is fixed at image-build time.
RUN mkdir -p /flezha/socket_data \
    && chown -R flezha:flezha /flezha \
    && chmod -R g+rw /flezha/socket_data

USER flezha

RUN mix local.hex --force && mix local.rebar --force

# Keep the container alive so `docker exec ... mix test` works.
CMD ["tail", "-f", "/dev/null"]
