FLEZHA_SOCKET_FILES_PATH="/flezha/socket_data/"
FLEZHA_TESTNET_WS_PORT=4500

# Transport selection: "uds" (default) or "quic"
FLEZHA_TRANSPORT=uds

# Logger configuration
FLEZHA_LOG_PATH="storage/logs/flezha.log"
FLEZHA_LOG_LEVEL="info"
FLEZHA_LOG_MAX_BYTES="10485760"
FLEZHA_LOG_KEEP_FILES="5"

# Erlang distribution cookie. Required: without it the controller starts with
# distribution off and no `flz` verb can reach it. Generate your own with
# `openssl rand -base64 48` - this value is an example, not a default.
RELEASE_COOKIE="replace-me-openssl-rand-base64-48"

# `none` keeps durability local-only. A prod release refuses to boot unset.
FLEZHA_DURABILITY_BACKEND=none
