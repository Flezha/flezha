# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
flezha-*.tar

# Rust build artifacts.
/target/

# Temporary files, for example, from tests.
/tmp/

# TODO file.
/TODO.md

# Ignore environment variables file
.env

# ElixirLS
.elixir_ls/

# Local process hub codebase.
/process-hub

# Log files
/logs/

# Local chaos harness + its soak/report outputs. Kept on disk (work in
# progress) but out of `git status` until it is ready to be committed.
/chaos/

# Openspecs
/openspec/changes
!/openspec/changes/archive

# Ad-hoc local test scripts (e.g. test-recovery-start.sh/stop.sh).
/scripts/temp/

# Maven build output. The Java compute-engine test fixture used to
# commit `target/` (compiled .class files + the shaded jar) so contributors
# could run `mix test` without `mvn` — but every rebuild produced a
# 5.8 MB binary diff and Maven internal scratch (`maven-status/`,
# `maven-archiver/`) leaked in. Building is now a documented
# prerequisite — see README "Building" / `mix test.java_sdk`.
test/apps/java_compute_engine/target/
test/apps/java_executor/target/
sdk/java/**/target/

# scripts/ci-local.sh isolates its Cargo artifacts here so it doesn't
# collide with anything else under /target/.
/target-ci-local/

# Memory-drift load-harness outputs.
/test/load/artifacts/*.json
/test/load/artifacts/*.log

# Claude Code per-project scratch.
/.claude/scheduled_tasks.lock

# Compiled NIF artifacts: Rustler rebuilds them from the flz_nif crate on
# `mix compile`, and the prod image cross-compiles its own per arch
# (docker/prod/Dockerfile.controller). They are also arch-specific
# (x86-64 here, aarch64 on the rpi5 controller) so a committed copy is
# both redundant and wrong for other targets.
/priv/native/*.so

# Local process_hub synced into the controller build context by the deploy
.process-hub-local/

# Local dev
.playwright-mcp
stash/*
# Local-only ops journal (per-incident prod freeze log)
/incident_log.md
# Local-only dev scratch: notes, brainstorms, ad-hoc files. Whole dir ignored.
/local_dev/
