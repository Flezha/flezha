defmodule AflechaTest.MigratorServiceTest do
  use ExUnit.Case
  use Aflecha.Constant

  doctest Aflecha.Worker.MigratorService

  @pipeline_id "test_migrator"

  setup do
    worker = NodeTestHelper.test_worker(@pipeline_id)

    %{worker: worker}
  end

  test "serialize worker" do
    serialized_data =
      Aflecha.Worker.MigratorService.serialize_pipeline(
        @default_group,
        @pipeline_id
      )

    assert is_list(serialized_data)
    assert length(serialized_data) > 0
  end

  test "deserialize worker" do
    serialized_data =
      Aflecha.Worker.MigratorService.serialize_pipeline(
        @default_group,
        @pipeline_id
      )

    assert :ok ===
             Aflecha.Worker.MigratorService.deserialize_pipeline(
               @default_group,
               @pipeline_id,
               serialized_data
             )
  end
end
