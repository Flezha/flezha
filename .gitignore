# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
flezha-*.tar

# Rust build artifacts.
/target/

# Python bytecode caches, written beside every module the runners import.
__pycache__/
*.py[cod]

# Temporary files, for example, from tests.
/tmp/

# TODO file.
/TODO.md

# Ignore environment variables file
.env

# ElixirLS
.elixir_ls/

# Local process hub codebase.
/process-hub

# Log files
/logs/

# Local chaos harness + its soak/report outputs. Kept on disk (work in
# progress) but out of `git status` until it is ready to be committed.
/chaos/

# Openspecs
/openspec/changes
!/openspec/changes/archive

# Ad-hoc local test scripts (e.g. test-recovery-start.sh/stop.sh).
/scripts/temp/

# Maven build output, and the native libraries and fat jars staged beside it.
# The Java compute-engine test fixture used to commit `target/` (compiled
# .class files + the shaded jar) so contributors could run `mix test` without
# `mvn` — but every rebuild produced a 5.8 MB binary diff and Maven internal
# scratch (`maven-status/`, `maven-archiver/`) leaked in. The five
# `libflz_core_ffi` binaries and the two fat jars were committed for the same
# reason and cost the same way, but 300× over: 1.7 GB of history across 163
# blobs, because flz_core_ffi sits underneath all seven and any kernel change
# invalidates them together. Building is now a documented prerequisite for all
# of them — see README "Building". `scripts/build-native.sh` produces the host
# triple every test path needs, and a release publishes all five;
# `scripts/check-build-artifacts.sh` holds the line.
test/apps/java_compute_engine/target/
test/apps/java_runner/target/
sdk/java/**/target/
examples/**/target/
sdk/java/flezha-sdk-native/src/main/resources/native/
sdk/java/flezha-sdk/dist/
test/apps/java_runner/dist/

# scripts/ci-local.sh isolates its Cargo artifacts here so it doesn't
# collide with anything else under /target/.
/target-ci-local/

# Memory-drift load-harness outputs.
/test/load/artifacts/*.json
/test/load/artifacts/*.log

# Ad-hoc bench outputs from the documented compare workflow
# (`./scripts/bench.sh ... | tee bench-rust.txt`) — never committed.
/bench-*.txt

# Compiled NIF artifacts: Rustler rebuilds them from the flz_nif crate on
# `mix compile`, and the prod image cross-compiles its own per arch
# (docker/prod/Dockerfile.controller). They are also arch-specific
# (x86-64 here, aarch64 on the rpi5 controller) so a committed copy is
# both redundant and wrong for other targets.
/priv/native/*.so

# Local process_hub synced into the controller build context by the deploy
.process-hub-local/

# Local dev
.playwright-mcp
stash/*
# Local-only dev scratch: notes, brainstorms, ad-hoc files. Whole dir ignored.
/local_dev/
# Agent coding-fleet prototype: own git repo, extracted to flezha-agents when its shape settles.
/examples/coding-fleet/

# Work in progress. The STRUCTURE is tracked: the readme, the invariants every
# session follows, the board templates, the worker briefs and the three scripts.
# The WORK is not: the live boards and the campaign archive are one team's notes
# on one day and are never a shipped artifact. Ignore everything, then allow the
# structure back, so a new working file is ignored by default.
/wip/*
!/wip/README.md
!/wip/INVARIANTS.md
!/wip/templates/
!/wip/briefs/
!/wip/status.py
!/wip/reap.sh
!/wip/reset.sh
