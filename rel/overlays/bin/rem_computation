#!/bin/sh
set -e

# Check if the number of arguments is at least 1
if [ "$#" -lt 1 ]; then
    echo "ERROR: removing computation requires at least 1 argument: computation_id"
    exit 1
fi

# Mandatory parameters
COMPUTATION_ID=$1

# Initialize optional variables
NODE_NAME=""

# Check for the optional arguments
while [ "$#" -gt 0 ]; do
    case $1 in
        -n|--node)
            NODE_NAME=$2
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# Get the directory of the current script
SCRIPT_DIR=$(dirname "$0")

# TODO: Reduce duplication
# Conditionally set RELEASE_NODE and execute the flecha_core command
if [ -n "$NODE_NAME" ]; then
    RELEASE_NODE=$NODE_NAME "$SCRIPT_DIR/flecha_core" rpc "Flecha.rem_computation(\"$COMPUTATION_ID\")"
else
    "$SCRIPT_DIR/flecha_core" rpc "Flecha.rem_computation(\"$COMPUTATION_ID\")"
fi