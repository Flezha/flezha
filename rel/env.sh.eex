#!/bin/sh

# # Sets and enables heart (recommended only in daemon mode)
# case $RELEASE_COMMAND in
#   daemon*)
#     HEART_COMMAND="$RELEASE_ROOT/bin/$RELEASE_NAME $RELEASE_COMMAND"
#     export HEART_COMMAND
#     export ELIXIR_ERL_OPTIONS="-heart"
#     ;;
#   *)
#     ;;
# esac

# # Set the release to load code on demand (interactive) instead of preloading (embedded).
# export RELEASE_MODE=interactive

# # Set the release to work across nodes.
# # RELEASE_DISTRIBUTION must be "sname" (local), "name" (distributed) or "none".

export FLEZHA_NODE_NAME=${FLEZHA_NODE_NAME:-<%= @release.name %>}
export FLEZHA_NODE_HOST=${FLEZHA_NODE_HOST:-127.0.0.1}

export RELEASE_NODE=${FLEZHA_NODE_NAME}@${FLEZHA_NODE_HOST}

# There is still no source-committed cookie. An operator-provisioned
# RELEASE_COOKIE wins outright; with none, this node mints 32 random bytes of
# its own, keeps them 0600 under the state directory and reads them back on
# every later boot. A minted value is unpredictable and shared with nobody, so
# the node clusters with no one until an operator provisions one value across
# the cluster. A node that can neither read nor mint one runs with distribution
# disabled rather than under a well-known constant.
flezha_cookie_file="${FLEZHA_COOKIE_FILE:-${FLEZHA_STATE_DIR:-${RELEASE_ROOT}/app_data/state}/cookie}"
flezha_cookie_is_local=""

if [ -z "${RELEASE_COOKIE}" ]; then
  # -s rather than -f: a zero-byte file is not a secret anyone shared, so a
  # node that filled its disk mid-write mints again rather than waiting for
  # someone to delete an empty file by hand.
  if [ -s "${flezha_cookie_file}" ]; then
    if flezha_cookie_value="$(cat "${flezha_cookie_file}" 2>/dev/null)"; then
      RELEASE_COOKIE="${flezha_cookie_value}"
      flezha_cookie_is_local=1
    fi
  elif mkdir -p "$(dirname "${flezha_cookie_file}")" 2>/dev/null &&
    flezha_cookie_value="$(od -An -vtx1 -N32 /dev/urandom 2>/dev/null | tr -d ' \n')" &&
    [ -n "${flezha_cookie_value}" ] &&
    (umask 077 && printf '%s\n' "${flezha_cookie_value}" >"${flezha_cookie_file}") 2>/dev/null &&
    chmod 600 "${flezha_cookie_file}" 2>/dev/null; then
    RELEASE_COOKIE="${flezha_cookie_value}"
    flezha_cookie_is_local=1
  fi

  unset flezha_cookie_value
fi

if [ -n "${RELEASE_COOKIE}" ]; then
  export RELEASE_COOKIE
  export RELEASE_DISTRIBUTION=${RELEASE_DISTRIBUTION:-name}

  # Only where the node is being started: this script is sourced by every `flz`
  # verb as well, and a line per verb would be noise rather than a warning.
  if [ -n "${flezha_cookie_is_local}" ]; then
    case "${RELEASE_COMMAND}" in
    start | start_iex | daemon | daemon_iex)
      echo "[flezha] no RELEASE_COOKIE provisioned; using the node-local cookie in ${flezha_cookie_file}." >&2
      echo "[flezha] That value is this node's alone. A cluster provisions RELEASE_COOKIE with the same value on every node." >&2
      ;;
    esac
  fi
else
  echo "[flezha] RELEASE_COOKIE is not set and none could be minted at ${flezha_cookie_file}; refusing to start Erlang distribution." >&2
  echo "[flezha] Provision a cookie (e.g. a Kubernetes Secret) to enable clustering." >&2
  export RELEASE_DISTRIBUTION=none
fi

# Optional TLS distribution: point FLEZHA_DIST_TLS_OPTFILE at an
# inet_tls_dist option file (see docs/operations/authn_authz.md) to encrypt
# and authenticate inter-node traffic. The provisioned cookie remains the
# mandatory floor either way.
if [ -n "${FLEZHA_DIST_TLS_OPTFILE}" ]; then
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS} -proto_dist inet_tls -ssl_dist_optfile ${FLEZHA_DIST_TLS_OPTFILE}"
fi
