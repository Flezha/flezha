defmodule FlezhaTest.PipelineManagerTest do
  use ExUnit.Case
  use Flezha.Constant

  import Flezha.Service.PipelineManager

  doctest Flezha.Service.PipelineManager

  test "start worker" do
    pipeline_id = "test_worker_start"

    worker = %Flezha.Pipeline.Builder{
      id: pipeline_id,
      factory_id: @factory_do_nothing
    }

    result = start_worker(@default_group, worker)

    assert elem(result, 0) === :ok
    assert is_tuple(elem(result, 1))
    assert result |> elem(1) |> elem(0) === pipeline_id
    assert is_list(result |> elem(1) |> elem(1))
  end

  test "stop worker" do
    worker = %Flezha.Pipeline.Builder{
      id: "rem_compuation_test",
      factory_id: @factory_do_nothing
    }

    {:ok, _} = start_worker(@default_group, worker)

    assert stop_worker(@default_group, worker.id) === :ok
  end

  test "worker validations" do
    worker = FlezhaTest.Fixtures.Worker.get("test_worker_validation", nil)

    result1 = start_worker(@default_group, worker)
    result2 = start_worker(@default_group, worker)

    assert elem(result1, 0) === :ok
    assert elem(result2, 0) === :error
    assert elem(result2, 1) === "worker id already in use"
  end

  test "validate worker length" do
    valid_worker = %Flezha.Pipeline.Builder{
      id: "worker_string_32_bytes_long",
      factory_id: @factory_do_nothing
    }

    invalid_worker = %Flezha.Pipeline.Builder{
      id: "some_very_long_pipeline_id_that_should_fail",
      factory_id: @factory_do_nothing
    }

    result1 = start_worker(@default_group, valid_worker)
    result2 = start_worker(@default_group, invalid_worker)

    assert elem(result1, 0) === :ok
    assert result2 === {:error, "worker id exceeds 32 bytes"}
  end
end
