defmodule FlezhaTest.IOManagerTest do
  alias Flezha.IO.IOManager
  use ExUnit.Case
  use Flezha.Constant

  doctest Flezha.IO.IOManager

  @computation_id "test_io_manager"

  setup do
    worker = NodeTestHelper.test_worker(@computation_id)

    %{worker: worker}
  end

  test "add IO input" do
    res1 =
      IOManager.add_io(
        @default_group,
        @computation_id,
        %Flezha.IO.Handler.BeamProcess{output_pid: self()},
        :input,
        []
      )

    res2 =
      IOManager.add_io(
        @default_group,
        "none",
        %Flezha.IO.Handler.BeamProcess{output_pid: self()},
        :input,
        []
      )

    assert elem(res1, 0) == :ok
    assert elem(res1, 1) |> is_binary()

    assert elem(res2, 0) == :error
    assert elem(res2, 1) === "worker not found"
  end
end
