# Build from the Elixir image
FROM elixir:1.17-otp-27

# Install the necessary dependencies
RUN apt-get update && apt-get install -y \
    libssl-dev \
    pkg-config \
    build-essential \
    cmake

# Copy the current directory contents into the container at /flezha
WORKDIR /flezha
COPY . .

# Create a non-root user and its home directory
RUN addgroup --gid 1000 flezha && adduser --uid 1000 --gid 1000 --home /home/flezha flezha

# Create home directory for the flezha user
RUN mkdir -p /home/flezha && \
    chown flezha:flezha /home/flezha

# Set home directory for the flezha user
ENV HOME=/home/flezha

# Switch to the root user to install Node.js and npm
USER root    
WORKDIR /home/flezha

# Install Node.js and npm
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs

# Install TypeScript globally
RUN npm install -g typescript

# Install Rust and necessary tools
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    echo '. "$HOME/.cargo/env"' >> $HOME/.bashrc && \
    echo '. "$HOME/.cargo/env"' >> $HOME/.profile && \
    . "$HOME/.cargo/env" && \
    rustup update && \
    rustup default stable

# Make Rust available in PATH for all subsequent RUN commands (needed for Rustler NIF compilation)
ENV PATH="/home/flezha/.cargo/bin:${PATH}"

RUN mkdir -p /flezha/socket_data && \
    chown -R flezha:flezha /flezha/socket_data && \
    chmod -R g+rw /flezha/socket_data

# Build the testnet application
WORKDIR /flezha/test/apps/testnet
RUN npm install
RUN npm run build

# Set version
ENV PROTOC_VERSION=23.4

# Install protoc (architecture-aware: works on amd64 and arm64)
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
      PROTOC_ARCH="x86_64"; \
    elif [ "$ARCH" = "aarch64" ]; then \
      PROTOC_ARCH="aarch_64"; \
    else \
      echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    curl -LO https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip \
    && unzip protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip -d /usr/local \
    && rm protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip

RUN protoc --version    

# Change the owner of the /flezha directory
RUN chown -R flezha:flezha /flezha

# Ensure the flezha user owns the .cargo directory
RUN mkdir -p /home/flezha/.cargo && \
    chown -R flezha:flezha /home/flezha/.cargo && \
    chmod -R u+rw /home/flezha/.cargo

# Build the entire Rust workspace (flz_transport, SDK, CLI, test compute engine)
USER flezha
WORKDIR /flezha
RUN . "$HOME/.cargo/env" && cargo build --workspace

# Set the working directory
WORKDIR /flezha

# Install system dependencies
RUN mix local.hex --force && \
    mix local.rebar --force

# Symlink CLI binary to expected path (workspace build outputs to target/, not cli/target/)
RUN mkdir -p cli/target && ln -sf /flezha/target/debug cli/target/debug

# Build the Elixir application
RUN mix deps.get && \
    mix compile && \
    mix release --overwrite

# Copy the    

# Keep the terminal open
CMD ["tail", "-f", "/dev/null"]