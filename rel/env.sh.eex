#!/bin/sh

# # Sets and enables heart (recommended only in daemon mode)
# case $RELEASE_COMMAND in
#   daemon*)
#     HEART_COMMAND="$RELEASE_ROOT/bin/$RELEASE_NAME $RELEASE_COMMAND"
#     export HEART_COMMAND
#     export ELIXIR_ERL_OPTIONS="-heart"
#     ;;
#   *)
#     ;;
# esac

# # Set the release to load code on demand (interactive) instead of preloading (embedded).
# export RELEASE_MODE=interactive

# # Set the release to work across nodes.
# # RELEASE_DISTRIBUTION must be "sname" (local), "name" (distributed) or "none".

export FLEZHA_NODE_NAME=${FLEZHA_NODE_NAME:-<%= @release.name %>}
export FLEZHA_NODE_HOST=${FLEZHA_NODE_HOST:-127.0.0.1}

export RELEASE_NODE=${FLEZHA_NODE_NAME}@${FLEZHA_NODE_HOST}

# There is still no source-committed cookie. A user-provisioned
# RELEASE_COOKIE wins outright; with none, a node start mints 32 random bytes
# of its own, keeps them 0600 under the state directory and reads them back on
# every later boot. A minted value is unpredictable and shared with nobody, so
# the node clusters with no one until a user provisions one value across
# the cluster. A node that can neither read nor mint one runs with distribution
# disabled rather than under a well-known constant.
flezha_cookie_file="${FLEZHA_COOKIE_FILE:-${FLEZHA_STATE_DIR:-${RELEASE_ROOT}/storage/app/state}/cookie}"
flezha_cookie_is_local=""

# Only a command that starts a node writes the cookie file. This script is
# sourced by every `flz` verb as well, and a verb that wrote one while a first
# start wrote its own would leave the file holding a value the node never used.
# The commands that join distribution: a node's start, or a verb's call to it.
case "${RELEASE_COMMAND}" in
start | start_iex | daemon | daemon_iex) flezha_joins=node ;;
rpc | remote | restart | stop | pid) flezha_joins=cli ;;
*) flezha_joins="" ;;
esac

if [ -z "${RELEASE_COOKIE}" ]; then
  # -s rather than -f: a zero-byte file is not a secret anyone shared, so a
  # start mints again rather than waiting for someone to delete an empty file
  # by hand.
  if [ -s "${flezha_cookie_file}" ]; then
    if flezha_cookie_value="$(cat "${flezha_cookie_file}" 2>/dev/null)"; then
      RELEASE_COOKIE="${flezha_cookie_value}"
      flezha_cookie_is_local=1
    fi
  elif [ "${flezha_joins}" = node ] &&
    flezha_cookie_value="$(od -An -vtx1 -N32 /dev/urandom 2>/dev/null | tr -d ' \n')" &&
    [ -n "${flezha_cookie_value}" ] &&
    mkdir -p "$(dirname "${flezha_cookie_file}")" 2>/dev/null; then
    # Written aside, then linked into place. A link never replaces a file, so
    # of two starts minting at once one value lands, and each start exports
    # what the file holds. Only an empty file is replaced.
    if (umask 077 && printf '%s\n' "${flezha_cookie_value}" >"${flezha_cookie_file}.$$") 2>/dev/null &&
      chmod 600 "${flezha_cookie_file}.$$" 2>/dev/null &&
      { ln "${flezha_cookie_file}.$$" "${flezha_cookie_file}" 2>/dev/null ||
        [ -s "${flezha_cookie_file}" ] ||
        mv -f "${flezha_cookie_file}.$$" "${flezha_cookie_file}" 2>/dev/null; } &&
      flezha_cookie_value="$(cat "${flezha_cookie_file}" 2>/dev/null)"; then
      RELEASE_COOKIE="${flezha_cookie_value}"
      flezha_cookie_is_local=1
    fi
    rm -f "${flezha_cookie_file}.$$"
  fi

  unset flezha_cookie_value
fi

# OTP reads the cookie from $HOME/.erlang.cookie when no command line names
# one, and any local user can read a command line. So a VM that joins
# distribution runs with HOME at a private directory holding the cookie: in the
# release's scratch directory, which a start already needs writable, since the
# controller owns every directory under its state root; one per node name and
# kind, so no verb changes what a starting node reads. Every level must be this
# user's own real directory, made 0700 before anything in it is trusted. The
# controller puts the user's HOME back as it starts (`Flezha.Application`).
flezha_private_home() {
  flezha_homes="${RELEASE_TMP:-${RELEASE_ROOT}/tmp}/home"
  flezha_home="${flezha_homes}/${RELEASE_NODE}/${flezha_joins}"
  (umask 077 && mkdir -p "${flezha_home}") 2>/dev/null || return 1
  for flezha_dir in "${flezha_homes}" "${flezha_homes}/${RELEASE_NODE}" "${flezha_home}"; do
    [ ! -L "${flezha_dir}" ] && [ -O "${flezha_dir}" ] && chmod 700 "${flezha_dir}" 2>/dev/null || return 1
  done
  [ ! -L "${flezha_home}/.erlang.cookie" ] || return 1
  if [ "$(cat "${flezha_home}/.erlang.cookie" 2>/dev/null)" != "${RELEASE_COOKIE}" ]; then
    (umask 077 && printf '%s' "${RELEASE_COOKIE}" >"${flezha_home}/.erlang.cookie.$$" &&
      mv -f "${flezha_home}/.erlang.cookie.$$" "${flezha_home}/.erlang.cookie") 2>/dev/null || {
      rm -f "${flezha_home}/.erlang.cookie.$$"
      return 1
    }
  fi
  export RELEASE_USER_HOME="${HOME}"
  export HOME="${flezha_home}"
}

# Why this command may not join distribution, empty when it may.
flezha_refusal=""
if [ -z "${RELEASE_COOKIE}" ]; then
  [ "${flezha_joins}" != node ] ||
    flezha_refusal="RELEASE_COOKIE is not set and none could be minted at ${flezha_cookie_file}"
# The sentinel keeps a newline inside or at the end from vanishing with `$( )`.
elif [ "$(printf '%s' "${RELEASE_COOKIE}" | LC_ALL=C tr -d ' -~'; echo x)" != x ]; then
  flezha_refusal="RELEASE_COOKIE holds a character Erlang does not take in a cookie (printable ASCII only)"
elif [ -n "${flezha_joins}" ] && ! flezha_private_home; then
  flezha_refusal="the cookie could not be placed in ${flezha_home}, which must be this user's own directory"
fi

if [ -n "${RELEASE_COOKIE}" ] && [ -z "${flezha_refusal}" ]; then
  export RELEASE_COOKIE
  export RELEASE_DISTRIBUTION=${RELEASE_DISTRIBUTION:-name}

  # Only where the node is being started: a line per verb would be noise
  # rather than a warning.
  if [ -n "${flezha_cookie_is_local}" ] && [ "${flezha_joins}" = node ]; then
    echo "[flezha] no RELEASE_COOKIE provisioned; using the node-local cookie in ${flezha_cookie_file}." >&2
    echo "[flezha] That value is this node's alone. A cluster provisions RELEASE_COOKIE with the same value on every node." >&2
  fi
elif [ "${flezha_joins}" = cli ]; then
  # No cookie this call may use, so nothing to reach without persisting one.
  # It answers exactly as an unreachable node does, which `flz` reports and
  # `flz boot await` retries.
  [ -z "${flezha_refusal}" ] || echo "[flezha] ${flezha_refusal}." >&2
  echo "--rpc-eval : RPC failed with reason :noconnection" >&2
  exit 1
else
  if [ "${flezha_joins}" = node ]; then
    echo "[flezha] ${flezha_refusal}; refusing to start Erlang distribution." >&2
    [ -n "${RELEASE_COOKIE}" ] ||
      echo "[flezha] Provision a cookie (e.g. a Kubernetes Secret) to enable clustering." >&2
  fi
  export RELEASE_DISTRIBUTION=none
fi

# Optional TLS distribution: point FLEZHA_DIST_TLS_OPTFILE at an
# inet_tls_dist option file (see docs/public/topics/core/authorization.md) to encrypt
# and authenticate inter-node traffic. The provisioned cookie remains the
# mandatory floor either way.
if [ -n "${FLEZHA_DIST_TLS_OPTFILE}" ]; then
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS} -proto_dist inet_tls -ssl_dist_optfile ${FLEZHA_DIST_TLS_OPTFILE}"
fi
