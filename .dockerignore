# build outputs
**/target
_build
deps
priv/native/*.so
**/node_modules
**/__pycache__
**/.elixir_ls
**/.lexical
cover
flezha-*.tar

# runtime / scratch
storage
*.dump
**/erl_crash.dump
bench-*.txt
BENCH.md
QUIC_DIAGNOSTICS.md
CHANGELOG.md
TODO.md

# scm / dev / tooling
.git
.github
.vscode
.idea
.openspec.yaml
deploy
docs
openspec
scripts

# Re-include the runtime entrypoint scripts. These are referenced by `COPY`
# in docker/prod/Dockerfile.{agent,controller} and have no other ingestion
# path, so they MUST stay in the build context.
!docker/prod/agent-entrypoint.sh
!docker/prod/controller-entrypoint.sh

# Java SDK is a separate deliverable — not needed for the agent build.
sdk/java

# The Java native libraries and fat jars. Untracked build output, so they are
# absent from a clean checkout and present only on a machine that has built
# them; naming them keeps that developer's build context the same size as the
# checkout's, whatever the broader rules above happen to cover.
sdk/java/flezha-sdk-native/src/main/resources/native
sdk/java/flezha-sdk/dist
sdk/java/test_app/dist

# The same library, built for the other veneers, and the package trees around
# it. `sdk/rust` holds the only Cargo workspace members under sdk/, so nothing
# here is read by the Rust build stage.
sdk/node/native
sdk/php/lib
sdk/php/vendor
sdk/python/.venv
sdk/python/dist
sdk/python/src/flezha/*.so
sdk/ruby/lib/flezha/*.so
sdk/ruby/pkg
sdk/elixir/_build
sdk/elixir/deps
sdk/elixir/priv
sdk/elixir/examples
sdk/elixir/test_app/_build

# Local-only working material: boards, notes, the bench and chaos harnesses.
local_dev

# Test tree — kept out of the prod context except for the testnet TS app
# (consumed by deploy/docker/dev/Dockerfile.runtime to bake the WS server into
# :latest-dev). The reference runner is a cargo workspace member whose
# Cargo.toml is read during metadata resolution even when only -p flz_nif -p flz
# is built, and it lives in `sdk/rust/test_app`.
test/*
!test/apps
test/apps/*
!test/apps/testnet
sdk/rust/test_app/target
sdk/rust/target
sdk/rust/macros/target
test/apps/testnet/node_modules
test/apps/testnet/dist
test/apps/testnet/dist-test
test/apps/testnet/.git
