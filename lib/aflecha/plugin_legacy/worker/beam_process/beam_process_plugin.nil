defmodule Aflecha.Plugin.Worker.BeamProcess.BeamProcessPlugin do
  require Logger

  use Aflecha.Plugin.Worker.LinkedProcessContract

  @impl true
  def plugin_type() do
    :worker_linked_process
  end

  @impl true
  def load() do
    :ok
  end

  @impl true
  def start_link(_) do
    GenServer.start_link(__MODULE__, {worker_id, io_struct, opts}, [])
  end
end
