# syntax=docker/dockerfile:1.28.0

# The Elixir/OTP toolchain the release is built with, and so the one a plugin
# package for this image must be built with: read by `elixir-build` and
# `plugin-builder` alike.
ARG ELIXIR_IMAGE=hexpm/elixir:1.20.5-erlang-28.5.0.8-debian-bookworm-20261027-slim

# rebar3 is fetched at a named release and checked against its published digest
# before use, by both stages that compile Erlang dependencies.
ARG REBAR3_VERSION=3.28.0
ARG REBAR3_SHA256=5a28b1cca082d3b023ec0f5df9d9f9d52557036c6f2a21c1ffa11b93a984dd42

# Stage 1 — Rust builder. Builds flz_nif.so and the flz CLI binary with
# --release. No protoc: the prost output is committed under
# crates/flz_core/src/generated.
FROM rust:1.99.0-slim-bookworm AS rust-build

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        pkg-config \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/workspace/_build/.target \
    cargo build --release -p flz_nif -p flz \
    && mkdir -p /artifacts \
    && cp _build/.target/release/libflz_nif.so /artifacts/flz_nif.so \
    && cp _build/.target/release/flz /artifacts/flz

# Stage 2 — Elixir builder. Assembles the Mix release using the
# pre-built NIF + CLI from Stage 1; cargo is not invoked here.
FROM ${ELIXIR_IMAGE} AS elixir-build

WORKDIR /app

# protobuf-compiler is needed by `use Protox` in lib/flezha/runner/
# commands_proto.ex, which shells out to protoc at compile time.
# git is needed by mix.exs's github: deps.
# cmake is needed by crc32cer, the checksum NIF the release ships for the
# Kafka plugin package, whose Makefile shells out to cmake.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        build-essential \
        cmake \
        git \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ENV MIX_ENV=prod \
    LANG=C.UTF-8

# Copy mix metadata first to maximise layer-cache hits when only source changes.
# The Elixir SDK and its test app are path dependencies, so their manifests are
# metadata too.
COPY mix.exs mix.lock ./
COPY sdk/elixir/mix.exs ./sdk/elixir/
COPY sdk/elixir/test_app/mix.exs ./sdk/elixir/test_app/

ARG REBAR3_VERSION
ARG REBAR3_SHA256
RUN --mount=type=cache,target=/root/.hex \
    (mix local.hex --force || mix archive.install github hexpm/hex branch latest --force) \
    && curl -fsSL -o /usr/local/bin/rebar3 \
        "https://github.com/erlang/rebar3/releases/download/${REBAR3_VERSION}/rebar3" \
    && echo "${REBAR3_SHA256}  /usr/local/bin/rebar3" | sha256sum -c - \
    && chmod +x /usr/local/bin/rebar3 \
    && mix local.rebar rebar3 /usr/local/bin/rebar3 --force \
    && mix deps.get --only prod

# RUSTLER_SKIP_COMPILATION makes rustler pick up the .so dropped into
# priv/native/ below instead of invoking cargo again. The Elixir SDK's socket
# client is not built at all (`config :flezha_sdk, socket_nif: false`), and the
# SDK reads the schema it compiles from this tree, which carries no fixture list.
ENV RUSTLER_SKIP_COMPILATION=true \
    FLEZHA_CONTRACT_DIR=/app

COPY config ./config
COPY rel ./rel
COPY crates/protobufs ./crates/protobufs
# The error catalogue the controller and the SDK compile their codes from.
COPY crates/flz_transport/errors.json ./crates/flz_transport/errors.json
COPY lib ./lib
COPY sdk/elixir ./sdk/elixir
COPY LICENSE rel/third_party/THIRD_PARTY_NOTICES.md ./
COPY LICENSES ./LICENSES
# What `flz mcp`'s knowledge tools serve.
COPY priv/ai_kit ./priv/ai_kit

RUN mkdir -p priv/native _build/.target/release
COPY --from=rust-build /artifacts/flz_nif.so ./priv/native/flz_nif.so
COPY --from=rust-build /artifacts/flz         ./_build/.target/release/flz

RUN --mount=type=cache,target=/root/.hex \
    ERL_FLAGS="+JMsingle true" mix compile \
    && mix release --overwrite

# Plugin builder, never part of the runtime image: the release's own toolchain
# with what compiling `flezha` as a dependency needs, for
# `mix flezha.plugin.package` in a plugin project mounted at /src. A plugin build
# never needs the controller's NIF, so rustler skips it.
#   docker build --target plugin-builder -t flezha/plugin-builder:<version> \
#     -f deploy/docker/prod/Dockerfile.controller .
FROM ${ELIXIR_IMAGE} AS plugin-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        build-essential \
        cmake \
        git \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ARG REBAR3_VERSION
ARG REBAR3_SHA256
RUN (mix local.hex --force || mix archive.install github hexpm/hex branch latest --force) \
    && curl -fsSL -o /usr/local/bin/rebar3 \
        "https://github.com/erlang/rebar3/releases/download/${REBAR3_VERSION}/rebar3" \
    && echo "${REBAR3_SHA256}  /usr/local/bin/rebar3" | sha256sum -c - \
    && chmod +x /usr/local/bin/rebar3 \
    && mix local.rebar rebar3 /usr/local/bin/rebar3 --force

ENV MIX_ENV=prod \
    LANG=C.UTF-8 \
    RUSTLER_SKIP_COMPILATION=true

WORKDIR /src

# Stage 3 — runtime image. The Mix release bundles ERTS, so the runtime
# only needs basic shared libs and tini. Runners attach via
# `bin/flzvm remote` (the dist-node rsh shipped inside the release).
FROM debian:bookworm-20261027-slim AS runtime

LABEL org.opencontainers.image.licenses="MPL-2.0" \
      org.opencontainers.image.source="https://github.com/flezha/flezha"

WORKDIR /flezha

ENV LANG=C.UTF-8 \
    MIX_ENV=prod

RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl3 \
        libstdc++6 \
        libtinfo6 \
        locales \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN addgroup --system --gid 1000 flezha \
    && adduser --system --uid 1000 --ingroup flezha flezha

COPY --from=elixir-build /app/_build/prod/rel/flezha /flezha/

# `mix release` writes one fixed cookie that every pull of the image would share;
# the launcher never reads it where distribution is on, so it is not shipped.
RUN rm -f /flezha/releases/COOKIE

# Graceful-restart entrypoint. See the controller-packaging spec
# ("Prod image entrypoint SHALL provide graceful-restart lifecycle")
# for the full env-var contract.
COPY deploy/docker/prod/controller-entrypoint.sh /usr/local/bin/controller-entrypoint.sh
RUN chmod +x /usr/local/bin/controller-entrypoint.sh

# Named volumes inherit the mount-point's image-time ownership, so each
# overlaid dir must exist with flezha:flezha or the non-root process
# hits EACCES on first write: a named volume over a path the image does
# not have is created at mount time owned by root. Every path the shipped
# compose file mounts is listed, state first, because that one is claimed
# before any other write happens and the boot refuses when it cannot be.
RUN mkdir -p /flezha/storage/app/state \
             /flezha/storage/app/data \
             /flezha/storage/app/plugins \
             /flezha/storage/app/sockets \
             /flezha/storage/app/certs \
             /flezha/storage/logs \
             /flezha/storage/app/snapshots \
             /flezha/storage/app/process_hub \
    && chown -R flezha:flezha /flezha

USER flezha

# Readiness = the controller's own verdict, evaluated once. A bound control
# socket is not it: the socket appears before any hub has replayed anything.
# `--timeout 0` is a single evaluation, which exits 0 only on `:ready` and
# names the unmet precondition otherwise.
HEALTHCHECK --interval=10s --timeout=5s --retries=10 --start-period=120s \
    CMD /flezha/bin/flz boot await --timeout 0 || exit 1

# tini handles zombie reaping and signal forwarding for the BEAM.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/controller-entrypoint.sh"]
