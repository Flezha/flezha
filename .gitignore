# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# rustc writes an internal-compiler-error report here when it panics.
rustc-ice-*.txt

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
flezha-*.tar

# Rust build artifacts.
/target/

# Python bytecode caches, written beside every module the runners import.
__pycache__/
*.py[cod]

# Temporary files, for example, from tests.
/tmp/

# TODO file.
/TODO.md

# Ignore environment variables file
.env

# VS Code workspace settings.
.vscode/

# ElixirLS
.elixir_ls/

# Local process hub codebase.
/process-hub

# Local chaos harness + its soak/report outputs. Kept on disk (work in
# progress) but out of `git status` until it is ready to be committed.
/chaos/

# Openspecs
/openspec/changes
!/openspec/changes/archive
/openspec/parked

# Ad-hoc local test scripts (e.g. test-recovery-start.sh/stop.sh).
/scripts/temp/

# Build output. The Java compute-engine test fixture used to commit `target/`,
# and every rebuild produced a binary diff; committed native libraries and fat
# jars once cost 1.7 GB of history. `scripts/check-build-artifacts.sh` holds the
# line. The Java SDK's libraries and jars are ignored in its own repository.
test/apps/java_compute_engine/target/
# Memory-drift load-harness outputs.
/test/load/artifacts/*.json
/test/load/artifacts/*.log

# Ad-hoc bench outputs from the documented compare workflow
# (`./scripts/bench.sh ... | tee bench-rust.txt`) — never committed.
/bench-*.txt

# Compiled NIF artifacts: Rustler rebuilds them from the flz_nif crate on
# `mix compile`, and the prod image cross-compiles its own per arch
# (docker/prod/Dockerfile.controller). They are also arch-specific
# (x86-64 here, aarch64 on the rpi5 controller) so a committed copy is
# both redundant and wrong for other targets.
/priv/native/*.so

# Local process_hub synced into the controller build context by the deploy
.process-hub-local/

# Local dev
.playwright-mcp
stash/*
# Local-only dev scratch: notes, brainstorms, ad-hoc files. Whole dir ignored.
/local_dev/
