# Stage 1: Build the Rust CLI
FROM rust:1.87.0 AS rust-build

# Set working directory for Rust build
WORKDIR /cli

# Copy the Rust CLI project
COPY ../cli ./

# Build the Rust project
RUN cargo build --release

# Stage 2: Build the Elixir app
FROM elixir:1.17-otp-27 AS build

# Set current working directory.
WORKDIR /app

# Install system dependencies
RUN mix local.hex --force
RUN mix local.rebar --force

# Copy all the necessary files to the container
COPY ../mix.exs ./mix.exs
COPY ../lib ./lib
COPY ../config ./config
COPY ../test ./test
COPY ../rel ./rel
COPY ../protobufs ./protobufs

# Copy the Rust build artifacts from the previous stage
COPY --from=rust-build /cli /app/cli

# Fetch dependencies
RUN MIX_ENV=prod mix deps.get

# Install system deps
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Set version
ENV PROTOC_VERSION=23.4

# Install protoc (architecture-aware)
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        PROTOC_ARCH="x86_64"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        PROTOC_ARCH="aarch_64"; \
    else \
        echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    curl -LO https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip \
    && unzip protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip -d /usr/local \
    && rm protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip

RUN protoc --version

# Compile the project
RUN ERL_FLAGS="+JMsingle true" MIX_ENV=prod mix compile

# Create release
RUN MIX_ENV=prod mix release --overwrite

# Stage 3: Final image
FROM elixir:1.17-otp-27

# Set the working directory
WORKDIR /flezha

# Set environment variables
ENV MIX_ENV=prod

# Create a non-root user and switch to it
RUN addgroup --system --gid 1000 flezha && adduser --system --uid 1000 --ingroup flezha flezha

# Copy only the necessary files from the _build/prod/rel/flezha directory
COPY --from=build /app/_build/prod/rel/flezha /flezha/

# Copy the Rust build artifacts to the final image
COPY --from=build /app/cli /flezha/cli

RUN mkdir -p /flezha/socket_data && \
    chown -R flezha:flezha /flezha/socket_data && \
    chmod -R g+rw /flezha/socket_data

# Change the owner of the /flezha directory
RUN chown -R flezha:flezha /flezha

# Switch to the flezha user
USER flezha

# Set the working directory
WORKDIR /flezha

# Start the application
CMD ["bin/agent", "start", "--mode=attached"]
