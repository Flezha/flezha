# ============================================================
# Stage 1 — Rust builder
# Compiles flz_nif (.so) and CLI binary (flz) with --release.
# ============================================================
FROM rust:1.87.0 AS rust-build

WORKDIR /workspace

# Copy entire workspace so all crate dependencies resolve
COPY . .

# Build NIF shared library and CLI binary
RUN cargo build --release -p flz_nif -p cli

# ============================================================
# Stage 2 — Elixir builder
# Compiles Elixir source and assembles the release.
# The NIF .so is copied from Stage 1; cargo is NOT invoked.
# ============================================================
FROM elixir:1.17-otp-27 AS build

WORKDIR /app

# Install system dependencies needed by mix deps / protobuf
RUN apt-get update && apt-get install -y \
    libssl-dev \
    pkg-config \
    build-essential \
    cmake \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install protoc (architecture-aware)
ENV PROTOC_VERSION=23.4
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
      PROTOC_ARCH="x86_64"; \
    elif [ "$ARCH" = "aarch64" ]; then \
      PROTOC_ARCH="aarch_64"; \
    else \
      echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    curl -LO https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip \
    && unzip protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip -d /usr/local \
    && rm protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip

RUN protoc --version

# Copy Elixir source files
COPY mix.exs mix.lock ./
COPY lib ./lib
COPY config ./config
COPY rel ./rel
COPY protobufs ./protobufs

# Place the pre-built NIF where Rustler expects it (skips cargo recompilation)
RUN mkdir -p priv/native
COPY --from=rust-build /workspace/target/release/libflz_nif.so ./priv/native/libflz_nif.so

# Place the pre-built CLI binary where mix.exs copy_cli_commands/1 expects it
RUN mkdir -p cli/target/release
COPY --from=rust-build /workspace/target/release/flz ./cli/target/release/flz

# Tell Rustler not to invoke cargo — use the pre-built .so above
ENV RUSTLER_SKIP_COMPILATION=true
ENV MIX_ENV=prod

RUN mix local.hex --force && mix local.rebar --force
RUN mix deps.get --only prod
RUN ERL_FLAGS="+JMsingle true" MIX_ENV=prod mix compile
RUN MIX_ENV=prod mix release --overwrite

# ============================================================
# Stage 3 — Runtime image
# Minimal image containing only the assembled release.
# ============================================================
FROM elixir:1.17-otp-27

WORKDIR /flezha

ENV MIX_ENV=prod

# Create non-root user
RUN addgroup --system --gid 1000 flezha && \
    adduser --system --uid 1000 --ingroup flezha flezha

# Copy assembled release from Stage 2
COPY --from=build /app/_build/prod/rel/flezha /flezha/

# Create runtime directories
RUN mkdir -p /flezha/app_data/sockets \
             /flezha/app_data/certs \
             /flezha/app_data/logs && \
    chown -R flezha:flezha /flezha

USER flezha

# bin/flzvm — Elixir release binary (renamed from bin/flezha by copy_cli_commands/1)
CMD ["bin/flzvm", "start"]
