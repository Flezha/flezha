defmodule Aflecha.Operator.Controller do
  alias Aflecha.Service.Identificator

  @impl true
  def handle_call({:get_worker_state, group_id, pipeline_id}, _from, state) do
    worker_state =
      GenServer.call(
        Identificator.control_unit(group_id),
        {:get_worker_state, pipeline_id}
      )

    {:reply, worker_state, state}
  end

  @impl true
  def handle_call({:start_pipeline, group_id, worker}, _from, state) do
    {:reply, response, state}
  end

  @impl true
  def handle_call({:stop_worker, group_id, pipeline_id}, _from, state) do
    response = rem_worker(group_id, pipeline_id)

    {:reply, response, state}
  end

  @impl true
  def handle_info({:factory_registered, _factory_id}, state) do
    {:noreply, state}
  end

  defp rem_worker(group_id, pipeline_id) do
    GenServer.call(
      Identificator.control_unit(group_id),
      {:stop_worker, pipeline_id}
    )

    result =
      ProcessHub.stop_child(Identificator.hub(group_id), pipeline_id, async_wait: true)
      |> ProcessHub.await()

    case result do
      {:ok, _} -> :ok
      {:error, reason} -> {:error, reason}
    end
  end
end
