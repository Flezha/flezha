defmodule FlezhaTest.RpcCookbookServiceTest do
  use ExUnit.Case
  use Flezha.Constant

  setup do
    %{}
  end

  test "rpc start worker" do
    pipeline_id = "test_rpc_start_comp"
    factory_id = "increment_state"
    {:ok, init_values} = Jason.encode(%{"value" => 100})

    result =
      Flezha.Service.RpcCookbook.worker_start(
        @default_group,
        pipeline_id,
        factory_id,
        init_values
      )

    assert elem(result, 0) === :ok
  end

  test "rpc stop worker" do
    pipeline_id = "test_rpc_stop_comp"

    FlezhaTest.Fixtures.Worker.get(pipeline_id, nil)
    |> FlezhaTest.Fixtures.Worker.start()

    result1 = Flezha.Service.RpcCookbook.worker_stop(@default_group, pipeline_id)
    result2 = Flezha.Service.RpcCookbook.worker_stop(@default_group, "non_existent")

    assert result1 === :ok
    assert result2 |> elem(0) === :error
    assert result2 |> elem(1) |> elem(0) === "non_existent"
    assert is_list(result2 |> elem(1) |> elem(1))
  end

  test "rpc no operator specified" do
    pipeline_id = "test_rpc_no_operator"

    result1 =
      Flezha.Service.RpcCookbook.worker_start("", pipeline_id, @factory_do_nothing, "{}")

    result2 = Flezha.Service.RpcCookbook.worker_stop("", pipeline_id)

    assert elem(result1, 0) === :ok
    assert result2 === :ok
  end

  test "rpc add io" do
    pipeline_id = "test_rpc_add_io"
    io_mode = :input
    io_params_json = ~s(
      {
        "io_type": "websocket",
        "uri": "#{@testnet_ws_uri}",
        "post_connect": {
          "payload": [
            "text",
            {
              "event_type": "subscribe",
              "event_data": {
                "default_message": "hello world",
                "interval": 1
              }
            }
          ]
        }
      }
    )

    NodeTestHelper.test_worker(pipeline_id)

    opts = [handling_type: :task]

    result1 =
      Flezha.Service.RpcCookbook.add_io(
        @default_group,
        pipeline_id,
        io_params_json,
        io_mode,
        opts
      )

    result2 =
      Flezha.Service.RpcCookbook.add_io(
        @default_group,
        "non_existent",
        io_params_json,
        io_mode,
        opts
      )

    assert is_tuple(result1)
    assert elem(result1, 0) === :ok
    assert elem(result1, 1) |> is_binary()

    assert is_tuple(result2)
    assert elem(result2, 0) === :error
    assert elem(result2, 1) === "worker not found"
  end
end
