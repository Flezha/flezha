defmodule AflechaTest.MigratorServiceTest do
  use ExUnit.Case
  use Aflecha.Constant

  doctest Aflecha.Worker.MigratorService

  @worker_id "test_migrator"

  setup do
    worker = TestHelper.test_worker(@worker_id)

    %{worker: worker}
  end

  test "serialize worker" do
    serialized_data =
      Aflecha.Worker.MigratorService.serialize_worker(
        @default_operator,
        @worker_id
      )

    assert is_list(serialized_data)
    assert length(serialized_data) > 0
  end

  test "deserialize worker" do
    serialized_data =
      Aflecha.Worker.MigratorService.serialize_worker(
        @default_operator,
        @worker_id
      )

    assert :ok ===
             Aflecha.Worker.MigratorService.deserialize_worker(
               @default_operator,
               @worker_id,
               serialized_data
             )
  end
end
