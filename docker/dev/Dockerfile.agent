# Build from the Elixir image
FROM elixir:1.17-otp-27

# Create a non-root user and its home directory
RUN addgroup --gid 1000 aflecha && adduser --uid 1000 --gid 1000 --home /home/aflecha aflecha

# Change the owner of the /home/aflecha directory
RUN chown -R aflecha:aflecha /home/aflecha

# Switch to the aflecha user before installing Rust
USER aflecha
ENV HOME=/home/aflecha

# Install Rust and necessary tools
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    echo '. "$HOME/.cargo/env"' >> $HOME/.bashrc && \
    echo '. "$HOME/.cargo/env"' >> $HOME/.profile && \
    . "$HOME/.cargo/env" && \
    rustup update && \
    rustup default stable

# Switch to the root user to install Node.js and npm
USER root    

# Install Node.js and npm
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs

# Install TypeScript globally
RUN npm install -g typescript

# Set the working directory
WORKDIR /aflecha

# Install system dependencies as root
RUN mix local.hex --force && \
    mix local.rebar --force

# Change the owner of the /aflecha directory
RUN chown -R aflecha:aflecha /aflecha

# Switch to the aflecha user
USER aflecha

# Start the application
CMD ["tail", "-f", "/dev/null"]