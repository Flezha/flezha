defmodule FlezhaTest.MigratorServiceTest do
  use ExUnit.Case
  use Flezha.Constant

  doctest Flezha.Worker.MigratorService

  @processor_id "test_migrator"

  setup do
    worker = NodeTestHelper.test_worker(@processor_id)

    %{worker: worker}
  end

  test "serialize worker" do
    serialized_data =
      Flezha.Worker.MigratorService.serialize_processor(
        @default_namespace,
        @processor_id
      )

    assert is_list(serialized_data)
    assert length(serialized_data) > 0
  end

  test "deserialize worker" do
    serialized_data =
      Flezha.Worker.MigratorService.serialize_processor(
        @default_namespace,
        @processor_id
      )

    assert :ok ===
             Flezha.Worker.MigratorService.deserialize_processor(
               @default_namespace,
               @processor_id,
               serialized_data
             )
  end
end
